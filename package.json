{
  "name": "family-os",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @family-os/api dev",
    "build": "pnpm --filter @family-os/shared build && pnpm --filter @family-os/api build",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @family-os/api test",
    "db:generate": "pnpm --filter @family-os/api db:generate",
    "db:migrate": "pnpm --filter @family-os/api db:migrate",
    "db:push": "pnpm --filter @family-os/api db:push",
    "db:studio": "pnpm --filter @family-os/api db:studio"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
