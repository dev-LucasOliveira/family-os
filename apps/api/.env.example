NODE_ENV=development
PORT=3000
LOCALE=pt-BR

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://family_os:family_os@localhost:5432/family_os?schema=public

# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: set when registering webhook (X-Telegram-Bot-Api-Secret-Token header)
TELEGRAM_WEBHOOK_SECRET=

# LLM — trocar para "groq" para usar Groq (requer GROQ_API_KEY)
LLM_PROVIDER=deterministic
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
